# ── AI Analysis ──────────────────────────────────────────────────────────────
# Required for AI-powered deal memos, risk flags, and investment thesis
ANTHROPIC_API_KEY=sk-ant-...

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Gmail example: use an App Password, not your account password
EMAIL_FROM=you@gmail.com
EMAIL_PASSWORD=your-app-password-here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Email Alert Settings ──────────────────────────────────────────────────────
# Automated alerts when a scraped deal scores above the threshold
ALERT_EMAIL_TO=you@example.com
ALERT_SCORE_THRESHOLD=7.0
